    {
      "parameters": {
        "resource": "request",
        "operation": "create",
        "formSource": "inline",
        "formName": "Documents for your mortgage application",
        "formBlocks": "[\n  { \"type\": \"header\", \"content\": \"Hi {{first_name}}, two things before we can continue\" },\n  { \"type\": \"paragraph\", \"content\": \"Upload your **last three payslips** and confirm how you are employed. It takes two minutes.\" },\n  { \"type\": \"hiddenField\", \"key\": \"first_name\" },\n  { \"type\": \"hiddenField\", \"key\": \"case_id\" },\n  { \"type\": \"select\", \"key\": \"employment\", \"title\": \"How are you employed?\", \"options\": [\"Employed\", \"Self-employed\", \"Retired\"] },\n  { \"type\": \"file\", \"key\": \"payslips\", \"title\": \"Your last three payslips\", \"maxFiles\": 3 },\n  { \"type\": \"text\", \"key\": \"notes\", \"title\": \"Anything we should know?\", \"required\": false }\n]",
        "inlinePrefill": "={{ JSON.stringify({ employment: $json.employment }) }}",
        "inlineContext": "={{ JSON.stringify({ first_name: $json.firstName, case_id: $json.caseId }) }}",
        "inlineReadonly": "",
        "formOptions": {
          "emoji": "🏦",
          "cover": "{ \"type\": \"color\", \"color\": \"#0f4c81\" }",
          "theme": "{ \"light\": \"solarized-light\" }"
        },
        "recipientEmail": "={{ $json.email }}",
        "waitForOutcome": true,
        "additionalFields": {
          "recipientName": "={{ $json.firstName }}",
          "externalId": "={{ $json.caseId + '-' + $execution.id }}"
        }
      },
      "type": "n8n-nodes-formstep.formstep",
      "typeVersion": 2,
      "position": [480, 0],
