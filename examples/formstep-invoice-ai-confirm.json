      "parameters": {
        "resource": "request",
        "operation": "create",
        "formId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "recipientEmail": "={{ $('Invoice').item.json.supplierEmail }}",
        "fields": {
          "mappingMode": "defineBelow",
          "value": {
            "supplier_name": "={{ $json.output.supplier_name }}",
            "invoice_number": "={{ $json.output.invoice_number }}",
            "invoice_date": "={{ $json.output.invoice_date }}",
            "due_date": "={{ $json.output.due_date }}",
            "total_amount": "={{ $json.output.total_amount }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "supplier_name",
              "displayName": "Supplier (supplier_name)",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": false,
              "display": true,
              "type": "string"
            },
            {
              "id": "invoice_number",
              "displayName": "Invoice Number (invoice_number)",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": false,
              "display": true,
              "type": "string"
            },
            {
              "id": "invoice_date",
              "displayName": "Invoice Date (invoice_date)",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": false,
              "display": true,
              "type": "dateTime"
            },
            {
              "id": "due_date",
              "displayName": "Due Date (due_date)",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": false,
              "display": true,
              "type": "dateTime"
            },
            {
              "id": "total_amount",
              "displayName": "Total Amount (total_amount)",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": false,
              "display": true,
              "type": "number"
            },
            {
              "id": "confirmed",
              "displayName": "I confirm these details are correct (confirmed)",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": false,
              "display": true,
              "type": "boolean",
              "removed": true
            },
            {
              "id": "notes",
              "displayName": "Notes (notes)",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": false,
              "display": true,
              "type": "string",
              "removed": true
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "readonly": [],
        "documents": {
          "values": [
            {
              "binaryProperty": "data",
              "name": "=Invoice {{ $json.output.invoice_number }}",
              "field": ""
            }
          ]
        },
        "waitForOutcome": true,
        "additionalFields": {
          "delivery": "email",
          "externalId": "={{ $json.output.invoice_number }}-{{ $execution.id }}",
          "expiresAt": "={{ $now.plus({ days: 5 }).toISO() }}",
          "test": true
        }
      },
      "type": "n8n-nodes-formstep.formstep",
      "typeVersion": 4,
      "position": [1340, 0],
      "id": "a1b2c3d4-0000-4000-8000-000000000037",
      "name": "Ask the supplier to confirm"
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "options": {}
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1560, 0],
      "id": "a1b2c3d4-0000-4000-8000-000000000039",
      "name": "Wait for the supplier",
      "webhookId": "3a17b0d1-0000-4000-8000-000000000038"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0ffee00-0000-4000-8000-0000000000a1",
              "leftValue": "={{ $json.body.type }}",
              "rightValue": "request.completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1780, 0],
      "id": "a1b2c3d4-0000-4000-8000-000000000040",
      "name": "Confirmed?"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compare what the AI read with what the supplier confirmed.\nconst read = $('Read the invoice with AI').item.json.output\nconst confirmed = $json.body.data.answers\nconst corrected = Object.keys(read).filter((key) => String(read[key]) !== String(confirmed[key]))\nreturn { json: { invoice: confirmed, corrected, notes: confirmed.notes ?? null } }"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, -100],
      "id": "a1b2c3d4-0000-4000-8000-000000000041",
      "name": "What the supplier corrected"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5e75e75e-0000-4000-8000-000000000042",
              "name": "to",
              "value": "={{ $('Invoice').item.json.supplierEmail }}",
              "type": "string"
            },
            {
              "id": "5e75e75e-0000-4000-8000-000000000043",
              "name": "message",
              "value": "=We still need you to confirm invoice {{ $('Read the invoice with AI').item.json.output.invoice_number }} ({{ $json.body.type }}).",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2000, 120],
      "id": "a1b2c3d4-0000-4000-8000-000000000044",
      "name": "No answer: chase the supplier"
    }
  ],
