              "description": "The invoice date, as YYYY-MM-DD",
              "required": true
            },
            {
              "name": "due_date",
              "type": "date",
              "description": "The payment due date, as YYYY-MM-DD",
              "required": true
            },
            {
              "name": "total_amount",
              "type": "number",
              "description": "The total to pay, including VAT, as a number without currency",
              "required": true
            }
          ]
