      "position": [880, 340],
      "id": "a1b2c3d4-0000-4000-8000-000000000035",
      "name": "Claude"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
